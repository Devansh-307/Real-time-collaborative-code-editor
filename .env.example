# ==============================================================================
# CodeSync - Real-time Collaborative Code Editor Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PYTHONUNBUFFERED=1

# API & Gateway Ports
FRONTEND_PORT=5173
API_PORT=8000
COLLAB_PORT=1234
GATEWAY_PORT=8080

# Public URLs (accessed by client browsers)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_COLLAB_WS_URL=ws://localhost:8080/collaboration

# Security & Sandboxing Constraints
EXECUTION_TIMEOUT_SECONDS=5
MAX_EXECUTION_TIMEOUT_SECONDS=15
MAX_SOURCE_SIZE_BYTES=102400
MAX_STDIN_SIZE_BYTES=65536
MAX_OUTPUT_LENGTH=65536
CONTAINER_MEMORY_LIMIT=256m
CONTAINER_CPU_QUOTA=1.0
CONTAINER_PIDS_LIMIT=64

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
