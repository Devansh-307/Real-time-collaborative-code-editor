# Multi-language secure sandbox runner image
FROM debian:bookworm-slim

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install compilers, runtimes, and core execution tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    gcc \
    g++ \
    python3 \
    python3-pip \
    nodejs \
    npm \
    openjdk-17-jdk-headless \
    golang-go \
    rustc \
    coreutils \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Create a non-privileged sandbox user with restricted home
RUN groupadd -g 1001 runner && \
    useradd -u 1001 -g runner -m -s /bin/bash runner

# Working directory inside container
WORKDIR /sandbox
RUN chown -R runner:runner /sandbox

# Switch to non-root runner user by default
USER runner

# Entrypoint default is a shell
CMD ["/bin/bash"]
